{
	"manifest_version": 3,
	"name": "TreeViz Connector",
	"version": "3.54.0",
	"description": "Compare an Ancestry or MyHeritage person with your TreeViz tree and write the values you confirm.",
	"key": "",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "TreeViz Connector",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": {
		"service_worker": "dist/background.js",
		"type": "module"
	},
	"permissions": ["storage", "scripting", "tabs"],
	"host_permissions": [
		"https://www.ancestry.com/*",
		"https://ancestry.com/*",
		"https://*.ancestry.com/*",
		"https://www.ancestry.co.uk/*",
		"https://ancestry.co.uk/*",
		"https://*.ancestry.co.uk/*",
		"https://www.ancestry.ca/*",
		"https://ancestry.ca/*",
		"https://*.ancestry.ca/*",
		"https://www.ancestry.com.au/*",
		"https://ancestry.com.au/*",
		"https://*.ancestry.com.au/*",
		"https://www.ancestry.de/*",
		"https://ancestry.de/*",
		"https://*.ancestry.de/*",
		"https://www.ancestry.fr/*",
		"https://ancestry.fr/*",
		"https://*.ancestry.fr/*",
		"https://www.ancestry.it/*",
		"https://ancestry.it/*",
		"https://*.ancestry.it/*",
		"https://www.ancestry.se/*",
		"https://ancestry.se/*",
		"https://*.ancestry.se/*",
		"https://www.ancestry.mx/*",
		"https://ancestry.mx/*",
		"https://*.ancestry.mx/*",
		"https://www.myheritage.com/*",
		"https://www.myheritage.hu/*",
		"https://www.myheritage.de/*",
		"https://www.myheritage.fr/*",
		"https://www.myheritage.es/*",
		"https://www.myheritage.it/*",
		"https://www.myheritage.pl/*",
		"https://www.myheritage.nl/*",
		"https://www.myheritage.dk/*",
		"https://www.myheritage.se/*",
		"https://www.myheritage.no/*",
		"https://www.myheritage.fi/*",
		"https://www.myheritage.pt/*",
		"https://treeviz.com/*",
		"https://www.treeviz.com/*",
		"https://dev.treeviz.com/*",
		"https://qa.treeviz.com/*",
		"http://localhost/*"
	],
	"externally_connectable": {
		"matches": [
			"https://treeviz.com/*",
			"https://www.treeviz.com/*",
			"https://dev.treeviz.com/*",
			"https://qa.treeviz.com/*",
			"http://localhost/*"
		]
	},
	"content_security_policy": {
		"extension_pages": "default-src 'self'"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.ancestry.com/*",
				"https://ancestry.com/*",
				"https://*.ancestry.com/*",
				"https://www.ancestry.co.uk/*",
				"https://ancestry.co.uk/*",
				"https://*.ancestry.co.uk/*",
				"https://www.ancestry.ca/*",
				"https://ancestry.ca/*",
				"https://*.ancestry.ca/*",
				"https://www.ancestry.com.au/*",
				"https://ancestry.com.au/*",
				"https://*.ancestry.com.au/*",
				"https://www.ancestry.de/*",
				"https://ancestry.de/*",
				"https://*.ancestry.de/*",
				"https://www.ancestry.fr/*",
				"https://ancestry.fr/*",
				"https://*.ancestry.fr/*",
				"https://www.ancestry.it/*",
				"https://ancestry.it/*",
				"https://*.ancestry.it/*",
				"https://www.ancestry.se/*",
				"https://ancestry.se/*",
				"https://*.ancestry.se/*",
				"https://www.ancestry.mx/*",
				"https://ancestry.mx/*",
				"https://*.ancestry.mx/*"
			],
			"js": ["dist/content/ancestry.js"],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://www.myheritage.com/*",
				"https://www.myheritage.hu/*",
				"https://www.myheritage.de/*",
				"https://www.myheritage.fr/*",
				"https://www.myheritage.es/*",
				"https://www.myheritage.it/*",
				"https://www.myheritage.pl/*",
				"https://www.myheritage.nl/*",
				"https://www.myheritage.dk/*",
				"https://www.myheritage.se/*",
				"https://www.myheritage.no/*",
				"https://www.myheritage.fi/*",
				"https://www.myheritage.pt/*"
			],
			"js": ["dist/content/myheritage.js"],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://treeviz.com/*",
				"https://www.treeviz.com/*",
				"https://dev.treeviz.com/*",
				"https://qa.treeviz.com/*",
				"http://localhost/*"
			],
			"js": ["dist/content/treeviz.js"],
			"run_at": "document_idle"
		}
	]
}
